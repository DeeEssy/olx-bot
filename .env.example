# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Твой chat_id (числом). Если не знаешь - запусти бота и напиши ему /start,
# он пришлёт твой chat_id в ответ.
TELEGRAM_CHAT_ID=

# Слаг города в URL olx.ua, например: kiev, odessa, lvov, kharkov, dnepr,
# vinnitsa, nikolaev, zaporozhe, poltava, chernigov, cherkassy, zhitomir,
# sumy, ternopol, lutsk, uzhgorod, khmelnitskiy, rovno, ivano-frankovsk
CITY_SLUG=kiev

# Название города для отображения в логах (необязательно)
CITY_NAME=Київ

# Диапазон цены в грн (пусто = без ограничения)
PRICE_MIN=
PRICE_MAX=

# Количество комнат через запятую, например "1,2" (пусто = любое)
ROOMS=

# Разрешать только объявления, где явно указано "можно с животными"
# true / false
PETS_ONLY=false

# Тип хозяина: any / agency / private
OWNER_TYPE=any

# Каждые сколько секунд проверять новые объявления
POLL_INTERVAL_SECONDS=300

# Сколько страниц поиска сканировать за один проход
PAGES_TO_SCAN=3

# Путь к файлу базы данных (для дедупликации)
DB_PATH=data/olx_bot.db
